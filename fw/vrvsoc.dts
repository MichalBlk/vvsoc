/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
    bootargs = "";
    linux,initrd-start = <0x80300000>;
    linux,initrd-end = <0x80700000>;
  };

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <50000000>;

		cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			riscv,isa = "rv32ima";
			mmu-type = "riscv,sv32";
			reg = <0>;
			clock-frequency = <50000000>;
			status = "okay";

			hlic: interrupt-controller {
				#interrupt-cells = <0x00000001>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x6000000>;
	};

  reserved-memory {
    #address-cells = <1>;
    #size-cells = <1>;
    ranges;

    opensbi@80100000 {
      reg = <0x80100000 0x100000>;
    };
  };

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		clint@70000000 {
			compatible = "riscv,clint0";
			interrupts-extended = <&hlic 0x3>, <&hlic 0x7>;
			reg = <0x70000000 0x10000>;
		};

		virtio@30000000 {
			compatible = "virtio,mmio";
			reg = <0x30000000 0x100>;
			interrupts-extended = <&hlic 0x10>;
		};
	};
};
